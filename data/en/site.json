  "levels": [
    {
      "lv": 0,
      "code": "L-0",
      "zh": "PUBLIC",
      "en": "PUBLIC",
      "desc": "Lowest tier. Granted to non-essential staff who need no contact with anomalous information — some logistics, clerical or janitorial posts. Usually no access card, or entry only to the most basic non-anomalous areas."
    },
    {
      "lv": 1,
      "code": "L-1",
      "zh": "CONFIDENTIAL",
      "en": "CONFIDENTIAL",
      "desc": "Basic confidentiality. Granted to employees whose workplace is near anomalies but who do not directly handle anomalous information or entities. May hold an access card, with a very limited scope."
    },
    {
      "lv": 2,
      "code": "L-2",
      "zh": "RESTRICTED",
      "en": "RESTRICTED",
      "desc": "Basic operational. Granted to researchers, field agents or security staff who need direct access to basic anomaly project information. This is where contact with core anomaly information begins."
    },
    {
      "lv": 3,
      "code": "L-3",
      "zh": "SECRET",
      "en": "SECRET",
      "desc": "Senior professional. Granted to senior researchers, project leads or MTF members who need deep knowledge of anomaly origins and the reasoning behind containment measures."
    },
    {
      "lv": 4,
      "code": "L-4",
      "zh": "TOP SECRET",
      "en": "TOP SECRET",
      "desc": "Site command. Granted to senior management requiring site- or region-level strategic intelligence — typically site directors, security chiefs or MTF commanders."
    },
    {
      "lv": 5,
      "code": "L-5",
      "zh": "THAUMIEL",
      "en": "THAUMIEL",
      "desc": "Foundation top authority. Granted to O5 Council members and a very few designated individuals; theoretically access to all strategic and sensitive data. Even at Level 5 the need-to-know principle still applies — not every file may be read at will."
    },
    {
      "lv": 6,
      "code": "L-6",
      "zh": "UNREGISTERED",
      "en": "UNREGISTERED",
      "desc": "This tier does not exist in the Foundation's current security clearance system. The personnel record cannot be verified, yet every encrypted dossier may be read."
    }
  ],
